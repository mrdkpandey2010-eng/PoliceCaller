# Cloudflare Configuration Placeholders
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id_here
CLOUDFLARE_R2_BUCKET_NAME=police-private-storage

# Application Security Secrets
JWT_SECRET_KEY=generate_a_cryptographically_secure_256_bit_secret_here
ADMIN_MFA_ENCRYPTION_KEY=generate_a_32_byte_aes_key_here

# Push Notification Keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
FCM_SERVER_KEY=your_firebase_server_key_here

# Environment Flag
APP_ENV=development
